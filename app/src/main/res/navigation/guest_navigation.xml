<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/guest_navigation"
    app:startDestination="@id/nav_start">

    <fragment
        android:id="@+id/nav_start"
        android:name="com.sample.application.ea.ui.guest.start.StartFragment"
        android:label="Start"
        tools:layout="@layout/fragment_start">
        <action
            android:id="@+id/action_nav_start_to_nav_sign_in"
            app:destination="@id/nav_sign_in"
            app:launchSingleTop="true"
            app:popUpTo="@id/guest_navigation"
            app:popUpToSaveState="false" />
    </fragment>
    <fragment
        android:id="@+id/nav_sign_in"
        android:name="com.sample.application.ea.ui.guest.signin.SignInFragment"
        android:label="Sign In"
        tools:layout="@layout/fragment_sign_in">
        <action
            android:id="@+id/action_nav_sign_in_to_nav_sign_up"
            app:destination="@id/nav_sign_up" />
    </fragment>

    <fragment
        android:id="@+id/nav_sign_up"
        android:name="com.sample.application.ea.ui.guest.signup.SignUpFragment"
        android:label="Sign Up"
        tools:layout="@layout/fragment_sign_up" />
</navigation>